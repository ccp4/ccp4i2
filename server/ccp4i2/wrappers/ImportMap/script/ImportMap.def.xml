<?xml version='1.0' encoding='ASCII'?>
<ccp4:ccp4i2 xmlns:ccp4="http://www.ccp4.ac.uk/ccp4ns">
  <ccp4i2_header>
    <function>DEF</function>
    <pluginName>ImportMap</pluginName>
  </ccp4i2_header>
  <ccp4i2_body id="ImportMap">
    <container id="inputData">
      <content id="MAPIN">
        <className>CMapDataFile</className>
        <qualifiers>
          <mustExist>True</mustExist>
          <allowUndefined>False</allowUndefined>
          <fromPreviousJob>False</fromPreviousJob>
          <guiLabel>Map file</guiLabel>
          <toolTip>A CCP4 or MRC format map file to import into the project</toolTip>
        </qualifiers>
      </content>
    </container>
    <container id="controlParameters">
      <content id="MAP_SUBTYPE">
        <className>CInt</className>
        <qualifiers>
          <onlyEnumerators>True</onlyEnumerators>
          <enumerators>1,2,3,4,5</enumerators>
          <menuText>Normal (electron density),Difference (Fo-Fc),Anomalous difference,Mask,Half map (one of a pair)</menuText>
          <default>1</default>
          <guiLabel>Map type</guiLabel>
          <toolTip>What kind of map this is. Half maps are one of a pair, used for cross-validated (FSC) refinement in servalcat and the cryo-EM placement task.</toolTip>
        </qualifiers>
      </content>
    </container>
    <container id="outputData">
      <content id="MAPOUT">
        <className>CMapDataFile</className>
        <qualifiers>
          <saveToDb>True</saveToDb>
        </qualifiers>
      </content>
    </container>
  </ccp4i2_body>
</ccp4:ccp4i2>
