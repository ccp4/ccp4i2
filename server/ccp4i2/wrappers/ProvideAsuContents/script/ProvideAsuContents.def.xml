<?xml version='1.0' encoding='ASCII'?>
<ccp4:ccp4i2 xmlns:ccp4="http://www.ccp4.ac.uk/ccp4ns">
  <ccp4i2_header>
    <function>DEF</function>
    <pluginName>ProvideAsuContents</pluginName>
  </ccp4i2_header>
  <ccp4i2_body id="ProvideAsuContents">
    <container id="inputData">
     <content id="ASUCONTENTIN">
        <className>CAsuDataFile</className>
        <qualifiers>
          <allowUndefined>True</allowUndefined>
          <saveToDb>True</saveToDb>
          <guiLabel>ASU content file</guiLabel>
          <toolTip>An existing ASU content file: its sequences are added to the table. The job itself works from the table (ASU_CONTENT).</toolTip>
        </qualifiers>
      </content>
      <content id="XYZIN">
        <className>CPdbDataFile</className>
        <qualifiers>
          <allowUndefined>True</allowUndefined>
          <fromPreviousJob>True</fromPreviousJob>
          <guiLabel>Model</guiLabel>
          <toolTip>A coordinate file (or a PDB entry fetched into the project): each polymer chain is added to the table, identical chains as copies of one row. The job itself works from the table (ASU_CONTENT).</toolTip>
        </qualifiers>
      </content>
      <content id="SEQIN">
        <className>CSeqDataFile</className>
        <qualifiers>
          <allowUndefined>True</allowUndefined>
          <guiLabel>Sequence file</guiLabel>
          <toolTip>A sequence file (or one fetched from UniProt or a PDB entry): its sequence is added to the table. The job itself works from the table (ASU_CONTENT).</toolTip>
        </qualifiers>
      </content>
      <content id="HKLIN">
        <className>CMtzDataFile</className>
        <qualifiers>
          <allowUndefined>True</allowUndefined>
              <fromPreviousJob>True</fromPreviousJob>
        </qualifiers>
      </content>
      <content id="ASU_CONTENT">
        <className>CAsuContentSeqList</className>
        <qualifiers/>
      </content>
      <qualifiers/>
    </container>
    <container id="controlParameters"/>
     <container id="outputData">
     <content id="ASUCONTENTFILE">
        <className>CAsuDataFile</className>
        <qualifiers>
	  <saveToDb>True</saveToDb>
        </qualifiers>
      </content>
    </container>
  </ccp4i2_body>
</ccp4:ccp4i2>
