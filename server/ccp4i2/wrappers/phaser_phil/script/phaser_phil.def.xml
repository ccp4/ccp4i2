<?xml version='1.0' encoding='UTF-8'?>
<!--
  Inputs and outputs only.

  controlParameters are built at runtime from the tool's own PHIL scope by
  PhilPluginScript, so they track the installed program rather than a snapshot
  taken when this file was generated. What stays here is what PHIL cannot
  express: CCP4i2's rich file types, which carry the file browser, validation
  and database registration.
-->
<ccp4i2>
  <ccp4i2_header>
    <function>DEF</function>
    <pluginName>phaser_phil</pluginName>
  </ccp4i2_header>
  <ccp4i2_body id="phaser_phil">
    <container id="inputData">
      <content id="XYZIN">
        <className>CPdbDataFile</className>
        <qualifiers>
          <ifAtomSelection>True</ifAtomSelection>
          <allowUndefined>False</allowUndefined>
          <mustExist>True</mustExist>
        </qualifiers>
      </content>
      <content id="F_SIGF">
        <className>CObsDataFile</className>
        <qualifiers>
          <allowUndefined>False</allowUndefined>
          <mustExist>True</mustExist>
        </qualifiers>
      </content>
    </container>
    <container id="outputData">
      <content id="XYZOUT">
        <className>CPdbDataFile</className>
        <qualifiers>
          <default>
            <subType>1</subType>
          </default>
        </qualifiers>
      </content>
    </container>
    <!-- controlParameters is intentionally empty: PhilPluginScript fills it
         from the tool's master PHIL at runtime. The container must exist for
         it to merge into. -->
    <container id="controlParameters">
      <qualifiers/>
    </container>
  </ccp4i2_body>
</ccp4i2>
