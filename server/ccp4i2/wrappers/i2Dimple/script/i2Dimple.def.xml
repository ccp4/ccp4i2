<?xml version='1.0' encoding='ASCII'?>
<ccp4i2>
    <ccp4i2_header>
        <function>DEF</function>
        <pluginName>i2Dimple</pluginName>
    </ccp4i2_header>
    <ccp4i2_body id="i2Dimple">
        <container id="inputData">
            <content id="XYZIN">
                <className>CPdbDataFile</className>
                <qualifiers>
                    <ifAtomSelection>True</ifAtomSelection>
                    <allowUndefined>False</allowUndefined>
                    <mustExist>True</mustExist>
                </qualifiers>
            </content>
            <content id="F_SIGF">
                <className>CObsDataFile</className>
                <qualifiers>
                    <allowUndefined>False</allowUndefined>
                    <mustExist>True</mustExist>
                </qualifiers>
            </content>
            <content id="FREERFLAG">
                <className>CFreeRDataFile</className>
                <qualifiers>
                    <mustExist>True</mustExist>
                    <allowUndefined>True</allowUndefined>
                    <fromPreviousJob>True</fromPreviousJob>
                    <sameCrystalAs>F_SIGF</sameCrystalAs>
                </qualifiers>
            </content>
        </container>
        <container id="controlParameters">
            <content id="MR_WHEN_R">
                <className>CFloat</className>
                <qualifiers>
                    <default>0.45</default>
                </qualifiers>
            </content>
            <content id="STRICT_CELL_MATCH">
                <className>CBoolean</className>
                <qualifiers>
                    <!-- Off by default. Dimple exists to fit a model that does
                         not quite match its data, so the observations and a
                         FreeR set brought from another crystal of the same
                         form routinely differ in cell by a percent or more.
                         Clipper's 1 A test then refuses the merge before
                         dimple ever runs. Tick this to require the cells to
                         agree, which catches data paired from the wrong
                         crystal at the cost of refusing a shared free set. -->
                    <default>False</default>
                    <guiLabel>Require the input cells to match</guiLabel>
                    <toolTip>When observations and a FreeR set come from different crystals of the same form -- a fragment campaign's shared free set -- their cells legitimately differ. Leave this off to merge them anyway, matching reflections by index and keeping the observations' cell. Tick it to refuse the merge when the cells disagree by more than 1 A on Clipper's test.</toolTip>
                </qualifiers>
            </content>
        </container>
        <container id="outputData">
            <content id="COMPLETE_MTZ">
                <className>CMtzDataFile</className>
                <qualifiers>
                    <saveToDb>True</saveToDb>
                    <label>Complete reflection file</label>
                </qualifiers>
            </content>
            <content id="XYZOUT">
                <className>CPdbDataFile</className>
                <qualifiers>
                    <default><subType>1</subType></default>
                </qualifiers>
            </content>
            <content id="DIFFPHIOUT">
                <className>CMapCoeffsDataFile</className>
                <qualifiers>
                    <default><subType>2</subType><contentFlag>1</contentFlag></default>
                    <saveToDb>True</saveToDb>
                </qualifiers>
            </content>
            <content id="FPHIOUT">
                <className>CMapCoeffsDataFile</className>
                <qualifiers>
                    <default><subType>1</subType><contentFlag>1</contentFlag></default>
                    <saveToDb>True</saveToDb>
                </qualifiers>
            </content>
            <content id="PERFORMANCEINDICATOR">
                <className>CRefinementPerformance</className>
            </content>
            <content id="COOTSCRIPTOUT">
                <className>CCootHistoryDataFile</className>
                <saveToDb>True</saveToDb>
            </content>
            <content id="F_SIGF_OUT">
                <className>CObsDataFile</className>
                <qualifiers>
                    <saveToDb>True</saveToDb>
                </qualifiers>
            </content>
            <content id="FREERFLAG_OUT">
                <className>CFreeRDataFile</className>
                <qualifiers>
                    <saveToDb>True</saveToDb>
                </qualifiers>
            </content>
        </container>
    </ccp4i2_body>
</ccp4i2>
